aov_2way <- aov(believability ~ context_word * genre, data = raw)
summary(aov_2way)
ss_2     <- summary(aov_2way)[[1]]$`Sum Sq`
ss_total <- sum(ss_2)
eta2_table <- data.frame(
Term              = c("context_word", "genre", "context_word:genre", "Residuals"),
Partial_eta2      = round(ss_2 / ss_total, 4)
)
eta2_table
emm <- emmeans(aov_2way, ~ context_word * genre)
emm
interaction_means <- raw %>%
group_by(context_word, genre) %>%
summarise(Mean = mean(believability, na.rm = TRUE),
SE   = sd(believability,   na.rm = TRUE) / sqrt(n()),
.groups = "drop")
p_interaction <- ggplot(interaction_means,
aes(x = context_word, y = Mean,
colour = genre, group = genre)) +
geom_line(linewidth = 0.9) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = Mean - SE, ymax = Mean + SE),
width = 0.15, linewidth = 0.5) +
geom_hline(yintercept = 3, linetype = "dashed", colour = "grey50") +
scale_colour_manual(values = genre_colours, name = "Genre") +
scale_y_continuous(limits = c(1, 5), breaks = 1:5) +
labs(title    = "Context × Genre Interaction: Mean Believability",
subtitle = "Error bars = ±1 SE; dashed line = scale midpoint",
x = "Context condition", y = "Mean believability (1–5)") +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
p_interaction
ggsave("output/interaction_context_genre.png", p_interaction,
width = 8, height = 5, dpi = 300)
clip_means_plot <- raw %>%
group_by(clip_name, genre) %>%
summarise(Mean = mean(believability, na.rm = TRUE),
SE   = sd(believability,   na.rm = TRUE) / sqrt(n()),
.groups = "drop") %>%
mutate(clip_short = sub("^[A-Za-z0-9]+_[A-Z]+_[0-9]+_", "", clip_name),
clip_short = sub("\\.mp3$", "", clip_short),
clip_short = gsub("_", " ", clip_short),
clip_short = factor(clip_short, levels = clip_short[order(Mean)]))
p_clip <- ggplot(clip_means_plot,
aes(x = clip_short, y = Mean, fill = genre)) +
geom_col(alpha = 0.85) +
geom_errorbar(aes(ymin = Mean - SE, ymax = Mean + SE),
width = 0.25, linewidth = 0.4) +
geom_hline(yintercept = 3, linetype = "dashed", colour = "grey40") +
scale_fill_manual(values = genre_colours, name = "Genre") +
scale_y_continuous(limits = c(0, 5), breaks = 1:5) +
coord_flip() +
labs(title    = "Mean Believability by Clip",
subtitle = "Collapsed across all four context conditions; error bars = ±1 SE; dashed line = scale midpoint",
x = NULL, y = "Mean believability (1–5)") +
theme_minimal(base_size = 11) +
theme(plot.title      = element_text(face = "bold"),
legend.position = "right")
p_clip
ggsave("output/bar_believability_by_clip.png", p_clip,
width = 10, height = 7, dpi = 300)
# Compute cell-level means, inheriting clip ordering from the overall ranking
clip_context_means <- raw %>%
group_by(clip_name, context_word, genre) %>%
summarise(Mean = mean(believability, na.rm = TRUE),
SE   = sd(believability,   na.rm = TRUE) / sqrt(n()),
.groups = "drop") %>%
mutate(clip_short = sub("^[A-Za-z0-9]+_[A-Z]+_[0-9]+_", "", clip_name),
clip_short = sub("\\.mp3$", "", clip_short),
clip_short = gsub("_", " ", clip_short))
# Apply the same clip ordering as the overall ranking plot
clip_order <- levels(clip_means_plot$clip_short)
clip_context_means$clip_short <- factor(clip_context_means$clip_short,
levels = clip_order)
p_clip_context <- ggplot(clip_context_means,
aes(x = clip_short, y = Mean, fill = genre)) +
geom_col(alpha = 0.85) +
geom_errorbar(aes(ymin = Mean - SE, ymax = Mean + SE),
width = 0.3, linewidth = 0.35) +
geom_hline(yintercept = 3, linetype = "dashed", colour = "grey40",
linewidth = 0.4) +
facet_wrap(~ context_word, ncol = 2,
labeller = labeller(context_word = c(
"bar"        = "Bar",
"concert"    = "Concert",
"movie"      = "Movie",
"video game" = "Video game"
))) +
scale_fill_manual(values = genre_colours, name = "Genre") +
scale_y_continuous(limits = c(0, 5), breaks = c(1, 3, 5)) +
coord_flip() +
labs(title    = "Mean Believability by Clip and Context Condition",
subtitle = "Faceted by context; clips ordered by overall mean believability;\nerror bars = ±1 SE; dashed line = scale midpoint",
x = NULL, y = "Mean believability (1–5)") +
theme_minimal(base_size = 10) +
theme(plot.title      = element_text(face = "bold"),
strip.text      = element_text(face = "bold", size = 10),
legend.position = "bottom",
panel.spacing   = unit(1, "lines"))
p_clip_context
ggsave("output/bar_believability_clip_by_context.png", p_clip_context,
width = 10, height = 10, dpi = 300)
p_heatmap <- ggplot(clip_context_means,
aes(x = context_word, y = clip_short, fill = Mean)) +
